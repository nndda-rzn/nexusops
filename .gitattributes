# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF for these files
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.svelte    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
*.example   text eol=lf
Dockerfile* text eol=lf
Makefile    text eol=lf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
bun.lock    binary
