# NexusOps API — Environment Variables
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
LOG_LEVEL=debug

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=postgresql://nexusops:nexusops_secret@localhost:5432/nexusops
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=nexusops

# ─────────────────────────────────────────
# Object Storage (MinIO)
# ─────────────────────────────────────────
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=nexusops
STORAGE_SECRET_KEY=nexusops_secret
STORAGE_USE_SSL=false
STORAGE_BUCKET_PREFIX=nexusops

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20
RATE_LIMIT_OPTIMIZATION=10
RATE_LIMIT_EXPORT=5
RATE_LIMIT_UPLOAD=20

# ─────────────────────────────────────────
# Compute Engine (Redis Streams)
# ─────────────────────────────────────────
COMPUTE_STREAM_PREFIX=nexusops:jobs
