{
  "name": "@nexusops/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx biome lint src/",
    "format": "bunx biome format --write src/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/shared/database/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "bun run src/shared/database/reset.ts",
    "db:seed": "bun run src/shared/database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
