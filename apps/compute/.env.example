# NexusOps Compute Engine — Environment Variables
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
WORKER_CONCURRENCY=2

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=postgresql://nexusops:nexusops_secret@localhost:5432/nexusops

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_STREAM_PREFIX=nexusops:jobs
REDIS_CONSUMER_GROUP=nexusops-workers

# ─────────────────────────────────────────
# Worker Config
# ─────────────────────────────────────────
JOB_MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=30
SOLVER_TIMEOUT_SECONDS=120
